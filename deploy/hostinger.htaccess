# Install only in public_html/nhhr; the WordPress root is separate.
Options -Indexes -MultiViews
DirectoryIndex index.html

<FilesMatch "(?i)\.(php[0-9]*|phtml|phar)(\..*)?$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /nhhr/
  RewriteCond %{REQUEST_URI} !^/nhhr(/|$)
  RewriteRule ^ - [F,L]
  # Block managed-checkout metadata and obsolete Clerk/PHP entry points,
  # including files left on hosting by an earlier release.
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^__clerk(/|$) - [F,L,NC]
  RewriteRule \.(php[0-9]*|phtml|phar)(/|$) - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^(assets|data)/ - [R=404,L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "^(index\.html|404\.html|release\.json|atlas-build\.json)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
