# Applies only inside public_html/nhhr. The WordPress root stays separate.
Options -Indexes -MultiViews
DirectoryIndex gate.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /nhhr/
  # Do not expose Git metadata created by a managed checkout.
  RewriteRule (^|/)\. - [F,L]
  # Every path, including stale files left by an older release, needs verification.
  RewriteRule ^gate\.php$ - [L]
  RewriteRule ^ gate.php [END]
</IfModule>

<IfModule mod_headers.c>
  Header always set Cache-Control "private, no-store, max-age=0"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
